{
  "name": "belgian-utils",
  "version": "0.7.1",
  "description": "Open source JavaScript utilities for Belgian business formats, local file privacy, PDF processing and Belgian calculations.",
  "homepage": "https://github.com/mhatipog/belgian-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhatipog/belgian-utils.git"
  },
  "bugs": {
    "url": "https://github.com/mhatipog/belgian-utils/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "test": "node --test",
    "test:smoke": "node --test test/finance-workflows.test.js test/reconciliation-v2.test.js",
    "test:pack": "node scripts/pack-smoke.mjs",
    "prepublishOnly": "npm test && npm run test:pack"
  },
  "keywords": [
    "belgium",
    "coda",
    "camt",
    "peppol",
    "ubl",
    "intervat",
    "xbrl",
    "iban",
    "vat",
    "kbo",
    "bce",
    "pdf",
    "privacy",
    "browser",
    "notice-period",
    "indexation",
    "mobility-budget",
    "nace",
    "working-days",
    "pain001",
    "iso20022",
    "reconciliation",
    "peppol-audit",
    "lez",
    "cadgis",
    "geopunt",
    "address-authorities",
    "property-data",
    "parquet",
    "delta-lake",
    "data-lake",
    "metadata",
    "eu-vat",
    "vies",
    "jsvat",
    "european-union",
    "vat-validation"
  ],
  "license": "MIT",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "fflate": "0.8.3",
    "hyparquet": "1.31.2",
    "hyparquet-writer": "0.16.10"
  },
  "main": "./src/index.js"
}
